<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <!-- Шапка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:weightSum="1"
        android:background="@color/black"
        android:layout_weight="0.15"
        android:paddingLeft="10dp"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.2"
            android:src="@drawable/ic_back"
            android:onClick="backToDevice"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.6"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="22dp"
            android:text="Холодильник"
            android:textColor="@color/white" />
        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.2" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.85"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/borders_2"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingBottom="40dp">

            <!-- Иконка и название -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:paddingTop="30dp"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_kitchen"
                    app:tint="@color/blue"
                    android:layout_weight="0.2"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Холодильник"
                    android:textColor="@color/black"
                    android:textAlignment="center"
                    android:layout_weight="0.6"
                    android:textStyle="bold"
                    android:textSize="24dp" />
                <ImageView
                    android:id="@+id/ivPower"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.2"
                    android:src="@drawable/ic_btn_on" />
            </LinearLayout>

            <!-- Температура -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="20dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Температура"
                    android:textColor="@color/gray"
                    android:textStyle="bold"
                    android:textSize="18sp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/btnMinus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_minus" />
                    <TextView
                        android:id="@+id/tvTemp"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="22°C"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/btnPlus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_add" />
                </LinearLayout>
            </LinearLayout>

            <!-- Режим (RadioGroup) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Режим"
                android:textStyle="bold"
                android:textColor="@color/gray"
                android:textSize="18sp" />

            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbEco"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/blue"
                    android:textSize="13dp"
                    android:textColor="@color/blue"
                    android:text="Эко"
                    android:layout_marginEnd="16dp" />

                <RadioButton
                    android:id="@+id/rbComfort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Комфорт"
                    android:textColor="@color/blue"
                    android:checked="true"
                    android:textSize="13dp"
                    android:layout_marginEnd="16dp" />

                <RadioButton
                    android:id="@+id/rbMax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13dp"
                    android:textColor="@color/blue"
                    android:text="Максимум" />
            </RadioGroup>

            <!-- Таймер -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvTimerValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="120"
                    android:paddingRight="8dp"
                    android:textColor="@color/gray"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="мин таймер"
                    android:paddingRight="8dp"
                    android:textColor="@color/gray"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/seekTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="360"
                android:progressTint="@color/blue"
                android:thumbTint="@color/blue"
                android:progress="120" />

            <!-- Датчик движения -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Датчик открытия"
                    android:textColor="@color/gray"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <ImageView
                    android:id="@+id/ivMotion"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_btn_on"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
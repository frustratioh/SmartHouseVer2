<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/black"
        android:layout_weight="0.1"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="20dp"
        android:text="Добавить адрес"
        android:textAlignment="center"
        android:textColor="@color/white" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:paddingLeft="30dp"
        android:layout_weight="0.7"
        android:paddingRight="30dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:paddingBottom="25dp"
            android:textStyle="bold"
            android:text="Добавьте адрес своего дома в формате г. Название города, ул. Название улицы, д. Номер дома"
            android:textColor="@color/vinous" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Адрес"
            android:textColorHint="@color/gray"
            app:cursorColor="@color/gray"
            app:hintTextColor="@color/gray"
            app:boxStrokeColor="@color/gray"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textColorHint="@color/gray"
                android:textColor="@color/gray"
                android:layout_height="match_parent"
                android:inputType="text"
                android:completionThreshold="1"/>

        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_weight="0.2"
        android:layout_height="0dp">
        <com.google.android.material.button.MaterialButton
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:text="Сохранить"
            android:textColor="@color/white"
            android:textSize="20dp"
            android:backgroundTint="@color/blue"
            app:cornerRadius="6dp"
            android:onClick="saveAddress"/>
    </LinearLayout>
</LinearLayout>
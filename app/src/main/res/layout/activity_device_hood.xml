<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <!-- Шапка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:weightSum="1"
        android:background="@color/black"
        android:layout_weight="0.15"
        android:paddingLeft="10dp"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.2"
            android:src="@drawable/ic_back"
            android:onClick="backToDevice"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.6"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="22dp"
            android:text="Умная дверь"
            android:textColor="@color/white" />
        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.2" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.85"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/borders_2"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingBottom="40dp">

            <!-- Иконка и название -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_hall"
                    app:tint="@color/blue"
                    android:layout_weight="0.2"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Умная дверь"
                    android:textColor="@color/black"
                    android:textAlignment="center"
                    android:layout_weight="0.6"
                    android:textStyle="bold"
                    android:textSize="24dp" />
                <ImageView
                    android:id="@+id/ivPower"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.2"
                    android:src="@drawable/ic_btn_on" />
            </LinearLayout>

            <!-- Мощность -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvPowerValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="70%"
                    android:paddingRight="8dp"
                    android:textColor="@color/gray"
                    android:textSize="18dp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="сила доводчика"
                    android:textColor="@color/gray"
                    android:textSize="18dp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/seekPower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:paddingTop="15dp"
                android:thumbTint="@color/blue"
                android:progressTint="@color/blue"
                android:progress="70" />

            <!-- Уровень шума -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvNoiseValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45"
                    android:paddingRight="8dp"
                    android:textColor="@color/gray"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="дБ громкость сирены"
                    android:paddingRight="8dp"
                    android:textColor="@color/gray"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/seekNoise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="80"
                android:progressTint="@color/blue"
                android:thumbTint="@color/blue"
                android:progress="45" />

            <!-- Режим (RadioGroup) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Режим"
                android:textStyle="bold"
                android:textColor="@color/gray"
                android:textSize="18sp" />

            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbNormal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Обычный"
                    android:textSize="13dp"
                    android:textColor="@color/blue"
                    android:checked="true"
                    android:layout_marginEnd="16dp" />

                <RadioButton
                    android:id="@+id/rbTurbo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Охрана"
                    android:textSize="13dp"
                    android:textColor="@color/blue"
                    android:layout_marginEnd="16dp" />

                <RadioButton
                    android:id="@+id/rbNight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/blue"
                    android:textSize="13dp"
                    android:text="Ночной" />
            </RadioGroup>

            <!-- Таймер -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvTimerValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60"
                    android:paddingRight="8dp"
                    android:textColor="@color/gray"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="сек автозакрытие"
                    android:paddingRight="8dp"
                    android:textColor="@color/gray"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/seekTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="180"
                android:progressTint="@color/blue"
                android:thumbTint="@color/blue"
                android:progress="60" />

            <!-- Подсветка -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Подсветка ручки"
                    android:textColor="@color/gray"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <ImageView
                    android:id="@+id/ivLight"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_btn_on"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
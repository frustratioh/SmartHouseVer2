<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartHouse" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>

        <!-- Цвета для EditText -->
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryVariant">@color/blue</item>
        <item name="colorOnSurface">@color/white</item>

        <!-- Стиль для диалогов -->
        <item name="android:alertDialogTheme">@style/AlertDialogTheme</item>
    </style>

    <style name="Theme.SmartHouse" parent="Base.Theme.SmartHouse" />

    <!-- Стиль для диалогового окна -->
    <style name="AlertDialogTheme" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:titleTextColor">@color/black</item>
        <item name="android:dialogMessage">@color/white</item>
        <item name="android:dialogTitle">@color/black</item>
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryDark">@color/blue</item>
        <item name="titleTextColor">@color/black</item>
        <item name="colorPrimaryContainer">@color/blue</item>
        <item name="colorAccent">@color/blue</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/blue</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/blue</item>
    </style>
</resources>